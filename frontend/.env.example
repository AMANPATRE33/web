# Frontend environment.
#
# Copy to `.env.local` for local development. `.env.local` is git-ignored; this
# file is the committed template and must never contain a real secret.
#
#   cp .env.example .env.local
#
# ---------------------------------------------------------------------------
# THE ONE RULE: `NEXT_PUBLIC_*` IS SHIPPED TO THE BROWSER
# ---------------------------------------------------------------------------
#
# Anything prefixed `NEXT_PUBLIC_` is inlined into the client bundle at build
# time. It is readable by anyone who opens the page source. Never put a secret
# behind that prefix.
#
# SAFE to expose (`NEXT_PUBLIC_`):
#   NEXT_PUBLIC_API_URL                 a URL, not a credential
#   NEXT_PUBLIC_SITE_URL                a URL, used for canonical/OG/sitemap
#   NEXT_PUBLIC_SITE_NAME               display text
#   NEXT_PUBLIC_SUPABASE_URL            a URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  the *publishable* key, designed for this
#   NEXT_PUBLIC_RAZORPAY_KEY_ID         the *key id*, public by design
#
# MUST NEVER APPEAR HERE (these live on the backend only):
#   SUPABASE_SERVICE_ROLE_KEY           bypasses all row-level security
#   SUPABASE_JWT_SECRET                 forges any user's access token
#   RAZORPAY_KEY_SECRET                 authorises charges/refunds against the account
#   RAZORPAY_WEBHOOK_SECRET             forges webhook deliveries
#   DATABASE_URL                        the database password
#   JWT_SECRET                          signs internal tokens
#
# The frontend never reads any of those. If you find yourself adding one here,
# the value belongs in the backend's environment instead.
#
# ---------------------------------------------------------------------------
# REQUIRED AT BUILD TIME
# ---------------------------------------------------------------------------
#
# These are inlined by `next build`, so they must be set **before** the build
# runs. Setting them after a build has no effect until you redeploy.
#
# The build genuinely needs the API, not just the variables:
#   * `/` is prerendered with a 30s revalidate, so it fetches the catalogue
#   * `/blog/[slug]` and `/policies/[slug]` use `generateStaticParams`, which
#     needs the real slugs
#   * the `/shop`, `/products/[slug]`, `/category/*`, `/search`, `/blog`,
#     `/industries/*`, `/5s`, `/msds`, `/bulk-order` and `/sitemap.xml` routes
#     render on demand and need the API on every request
#
# A build with no reachable API fails at `Error occurred prerendering page "/"`.

# Where the FastAPI backend runs. No trailing slash - it is stripped on read.
#   local:  http://localhost:8000
#   hosted: https://<your-railway-domain>
NEXT_PUBLIC_API_URL=http://localhost:8000

# The public origin of this storefront, absolute, no trailing slash.
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# Must match the deployed domain or canonical/OG tags point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Shown in the header, footer and <title> fallback.
NEXT_PUBLIC_SITE_NAME=Safety Poster Prints

# --- Supabase -------------------------------------------------------------
# Only needed once account sign-in is live. Leave blank for a catalogue-only
# deployment; the account pages render a signed-out state.
# The PUBLISHABLE key is safe in the browser. The SERVICE ROLE key is not, and
# must never appear in this file - it belongs on the backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Razorpay -------------------------------------------------------------
# The key *id* is public by design; Razorpay's checkout script needs it in the
# browser. The key *secret* authorises charges and must stay on the backend.
# Unused until the payment phase is built.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
