# =============================================================================
# storefront - environment template
# =============================================================================
# Copy to .env at the repository root and fill in real values.
#   cp .env.example .env
# NEVER commit .env. It is git-ignored and must stay git-ignored.
# =============================================================================

# --- Shared -----------------------------------------------------------------
# Which environment the whole stack is running in. Never use "production"
# outside of production. Drives logging verbosity and safety rails.
APP_ENV=development                       # development | staging | production
APP_NAME=storefront-api
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
# Public origin of the frontend. Used for CORS, absolute URLs in emails and
# structured data, and OpenAPI docs.
FRONTEND_URL=http://localhost:3000
# Public base URL of THIS backend (used in emails, order references, docs).
BACKEND_URL=http://localhost:8000

# =============================================================================
# DATABASE  (Supabase PostgreSQL)
# =============================================================================
# Use the DIRECT connection string (port 5432) for both migrations and the
# application. The Supabase transaction pooler (port 6543) is not used because
# asyncpg relies on server-side prepared statements.
#
#   Host    : db.<project-ref>.supabase.co
#   Port    : 5432
#   User    : postgres
#   Password: <database password>
#   DB      : postgres
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Optional: read/write split for reporting. Falls back to DATABASE_URL.
# DATABASE_READ_URL=
# Connection pool sizing. Tune against your DB plan's max connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false                             # true logs every SQL statement
DB_STATEMENT_TIMEOUT_MS=15000              # server-side guard against slow queries

# =============================================================================
# SUPABASE  (Auth + Storage + Admin API)
# =============================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key. SERVER ONLY. Grants full admin access - bypasses RLS.
# It must never be prefixed with NEXT_PUBLIC_ and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key. Only ever used by the frontend for Auth and Realtime.
SUPABASE_PUBLISHABLE_KEY=
# JWT verification. New Supabase projects use asymmetric (ES256/RS256) keys -
# leave the secret empty and the API will fetch the JWKS from SUPABASE_URL.
# Legacy HS256 projects set the shared secret here instead.
SUPABASE_JWT_SECRET=
# Storage bucket that holds product and editorial imagery.
SUPABASE_STORAGE_BUCKET=product-images
# Redirect allow-list for auth emails (comma separated).
SUPABASE_REDIRECT_URLS=http://localhost:3000/auth/callback

# =============================================================================
# AUTH / SECURITY
# =============================================================================
# Secret used to sign our own short-lived service tokens (webhook callbacks,
# internal worker jobs). >= 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-48-random-characters-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
# Comma-separated exact origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000
# Security headers applied by the API.
SECURITY_HEADERS_ENABLED=true
# Rate limiting. Per-IP and per-user buckets on sensitive endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120                  # general API requests / minute / IP
RATE_LIMIT_AUTH_REQUESTS=8               # login + signup attempts / minute / IP
RATE_LIMIT_WRITE_REQUESTS=30             # cart + checkout writes / minute / user

# =============================================================================
# RAZORPAY  (payments)
# =============================================================================
# Only the key id is public. The key secret must never leave the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay dashboard for the /payments/webhook route.
RAZORPAY_WEBHOOK_SECRET=
# test | live
RAZORPAY_MODE=test
# Optional: cap capture amount. Left empty the API always captures.
RAZORPAY_CAPTURE_METHOD=automatic
# Maximum seconds a payment intent stays valid before it must be re-created.
PAYMENT_INTENT_TTL_SECONDS=900
# Refunds > this fraction of order total require a second admin confirmation.
REFUND_REQUIRES_CONFIRMATION_ABOVE=5000.00

# =============================================================================
# EMAIL
# =============================================================================
# Provider-agnostic. Business logic never imports a concrete provider.
EMAIL_PROVIDER=console                    # console | resend | ses | smtp
EMAIL_FROM_NAME=Storefront
EMAIL_FROM_EMAIL=orders@example.com
EMAIL_REPLY_TO=support@example.com
# resend
RESEND_API_KEY=
# ses (Amazon SES v2 API)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# =============================================================================
# REDIS  (rate limiting + background jobs)
# =============================================================================
# Local development: redis://127.0.0.1:6379/0
# Use 127.0.0.1, not "localhost": on some hosts "localhost" resolves to ::1
# first and an IPv4-only Redis silently drops the connection, which surfaces as
# a connect timeout rather than a connection refusal.
# Railway: attach a Redis plugin and copy REDIS_URL.
REDIS_URL=redis://127.0.0.1:6379/0
# ARQ queue names. Keep the job queue separate from the cache/limiter DB.
REDIS_CACHE_DB=0
REDIS_JOB_DB=1
# Worker concurrency (number of simultaneous jobs).
WORKER_CONCURRENCY=10
# --- job schedule (cron, UTC) ---
JOB_ABANDONED_CART_HOURS=6
JOB_ANALYTICS_CRON=17 3 * * *
JOB_NEWSLETTER_DIGEST_CRON=23 7 * * 1
JOB_LOW_STOCK_REPORT_CRON=41 8 * * *

# =============================================================================
# STOREFRONT / CATALOGUE POLICY
# =============================================================================
# All money values are integer minor units (paise). Never floats.
CURRENCY=INR
CURRENCY_SYMBOL=Rs.
# Tax. INCLUSIVE means prices already contain tax (India default).
TAX_MODE=inclusive                         # inclusive | exclusive
TAX_RATE=0.18
TAX_INCLUSIVE_LABEL=incl. all taxes
# Shipping.
SHIPPING_FLAT_RATE=99.00
SHIPPING_FREE_ABOVE=4999.00
# Abandoned cart recovery window.
CART_ABANDONED_AFTER_MINUTES=360
# Number of days a customer order detail page stays queryable.
ORDER_RETENTION_DAYS=730

# =============================================================================
# UPLOADS  (Supabase Storage)
# =============================================================================
UPLOAD_MAX_BYTES=5242880                  # 5 MiB
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif
UPLOAD_SIGNED_URL_TTL_SECONDS=3600

# =============================================================================
# FRONTEND ONLY - these are inlined into the browser bundle at build time.
# Defined in the frontend workspace (.env.local) or in Vercel project settings.
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_NAME=Storefront

# =============================================================================
# LOCAL DEVELOPMENT DATABASE (optional)
# =============================================================================
# The isolated throwaway Postgres cluster created by scripts/local-postgres.ps1.
LOCAL_PG_PORT=55432
LOCAL_PG_USER=storefront
LOCAL_PG_PASSWORD=storefront_dev_only
LOCAL_PG_DATABASE=storefront
