# ---------------------------------------------------------------------------
# Secrets -- never commit real values
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!backend/app/**/*.py

# ---------------------------------------------------------------------------
# Local development infrastructure (isolated Postgres cluster, logs)
# ---------------------------------------------------------------------------
.local/
*.log
logs/

# ---------------------------------------------------------------------------
# Python / backend
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.hypothesis/
uv.lock.bak

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.vercel/
*.tsbuildinfo
next-env.d.ts
.turbo/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Testing artefacts
# ---------------------------------------------------------------------------
playwright-report/
test-results/
blob-report/
.playwright/
/tmp/e2e-artifacts

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
# Committed on purpose: these hold no personal paths or secrets, they just encode
# how to start the two services and run each test suite, and every new developer
# otherwise has to rediscover the commands from the README.
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local data / scratch
# ---------------------------------------------------------------------------
*.sqlite3
*.db
scratch/

# Visual QA screenshots. Regenerated by `npm run qa`; they are evidence of
# a run, not a source of truth, and would otherwise be churned every commit.
frontend/qa/screenshots/
