# Backend environment.
#
# Copy to `.env` at the REPOSITORY ROOT (not in backend/) for local development.
# That file is git-ignored. This template must never contain a real secret.
#
# On Railway these become Service Variables, set in the dashboard or via
# `railway variables set`. Never commit a filled-in copy.
#
# ---------------------------------------------------------------------------
# REQUIRED TO START
# ---------------------------------------------------------------------------
#
# Startup is lazy: the app binds its port without touching PostgreSQL or Redis,
# so a database that is briefly unavailable causes failed requests rather than a
# crash loop. It still needs these to do anything useful.

# The PostgreSQL connection string, asyncpg dialect.
# Railway's Postgres plugin injects this automatically as DATABASE_URL when you
# add the plugin - you do not normally set it by hand.
#   local:  postgresql+asyncpg://storefront:storefront_dev_only@127.0.0.1:55432/storefront
DATABASE_URL=

# Signs short-lived internal tokens for worker hand-off. Must be at least 32
# characters and must not be the placeholder, or the app refuses to start in
# production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of origins allowed to call this API. No wildcards: a
# validator rejects `*` outright. In production this must be the Vercel domain.
#   local:  http://localhost:3000
#   hosted: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Used for the CORS response and for any self-referential links.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# "development" or "production". Production turns on the startup safety rails
# below, so it also changes what the app refuses to boot without.
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION FOR AUTH
# ---------------------------------------------------------------------------
#
# Account sign-in is verified against Supabase. The catalogue does not need it -
# a deployment without it serves browsing and the public API and shows
# signed-out account pages - but APP_ENV=production refuses to start without it,
# because an account system that silently accepts unverified tokens is worse
# than one that is visibly unavailable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only legacy HS256 projects need this. New projects use JWKS.
SUPABASE_JWT_SECRET=
# The *publishable* key. Safe in the browser, and also needed here for admin
# operations.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ---------------------------------------------------------------------------
# PAYMENTS - NOT REQUIRED YET
# ---------------------------------------------------------------------------
#
# The checkout -> order -> payment pipeline is not built, so there is no payment
# route to misconfigure and these are not required to start. Setting
# PAYMENTS_ENABLED=true makes all three mandatory again, which is what you want
# in the same deploy that turns payments on.
#
# The key *secret* authorises charges and refunds against the account. It must
# never reach the browser and must never appear in the frontend's variables.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
RAZORPAY_CAPTECTURE_METHOD=automatic

# ---------------------------------------------------------------------------
# EMAIL - NOT REQUIRED YET
# ---------------------------------------------------------------------------
#
# `console` logs the message instead of sending it and needs no credentials.
# There is no order-email path yet, so nothing here is load-bearing today.
# When you switch to a real provider, its key becomes required.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Safety Poster Prints
EMAIL_FROM_EMAIL=
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# REDIS - OPTIONAL
# ---------------------------------------------------------------------------
#
# Rate limiting, response caching and the arq job queue. The app runs without
# it; those features degrade.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=8
RATE_LIMIT_WRITE_REQUESTS=30

# ---------------------------------------------------------------------------
# CATALOGUE / MONEY
# ---------------------------------------------------------------------------
#
# "inclusive" means GST is inside the displayed price, which is how Indian retail
# quotes. These drive the order-total constraint on `orders`, so a wrong value
# here is a tax-document problem, not a display problem. The company's own GSTIN
# is NOT configured here - it is unpublished, see docs/CONTENT_PENDING.md.
CURRENCY=INR
CURRENCY_SYMBOL=Rs.
TAX_MODE=inclusive
# A fraction, not a percentage: 0.18 means 18%.
TAX_RATE=0.18
# CGST/SGST for an intra-state supply, IGST for inter-state.
TAX_SPLIT_MODE=INTRA_STATE
# Placeholder figures. The real shipping matrix is unpublished - see
# docs/CONTENT_PENDING.md.
SHIPPING_FLAT_RATE=99.00
SHIPPING_FREE_ABOVE=4999.00

# ---------------------------------------------------------------------------
# BACKGROUND JOBS
# ---------------------------------------------------------------------------
#
# `arq` is installed but `app.workers` does not exist yet, so there is no worker
# service to run. When it is built it will be a second Railway service from the
# same image with a different start command.
WORKER_CONCURRENCY=5
JOB_ABANDONED_CART_HOURS=6
JOB_ANALYTICS_CRON=17 3 * * *
JOB_NEWSLETTER_DIGEST_CRON=23 7 * * 1
JOB_LOW_STOCK_REPORT_CRON=41 8 * * *

# ---------------------------------------------------------------------------
# DATABASE POOL
# ---------------------------------------------------------------------------
#
# A single Railway container usually has 1-2 vCPUs. The defaults are
# conservative because an over-large pool plus Railway's own connection
# proxying is a common way to exhaust Postgres connections and get 503s that
# look like application errors.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_STATEMENT_TIMEOUT_MS=15000

# Optional read replica. Falls back to DATABASE_URL.
DATABASE_READ_URL=

# ---------------------------------------------------------------------------
# MISC
# ---------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
CART_ABANDONED_AFTER_MINUTES=360
ORDER_RETENTION_DAYS=730
UPLOAD_MAX_BYTES=5242624
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif
UPLOAD_SIGNED_URL_TTL_SECONDS=3600
